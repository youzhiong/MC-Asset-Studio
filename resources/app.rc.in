#define IDI_APP_ICON 101

IDI_APP_ICON ICON "@MCSTUDIO_ICON_PATH@"
1 24 "@MCSTUDIO_MANIFEST_PATH@"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MC Studio"
            VALUE "FileDescription", "Minecraft Asset Studio"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "MCStudio"
            VALUE "OriginalFilename", "MCStudio.exe"
            VALUE "ProductName", "MC Asset Studio"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
